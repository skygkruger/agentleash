# ═══════════════════════════════════════════════════════════════
# SCOPEAGENT ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ───────────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# For Next.js client-side (prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ───────────────────────────────────────────────────────────────
# AUTHENTICATION (Required)
# ───────────────────────────────────────────────────────────────

# JWT secret for API tokens (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-minimum-32-characters-long

# API key HMAC secret (for secure API key hashing)
# Generate with: openssl rand -base64 32
API_KEY_SECRET=your-api-key-secret-minimum-32-characters

# Session duration (default: 7d)
SESSION_DURATION=7d

# ───────────────────────────────────────────────────────────────
# API SERVER (Required for API)
# ───────────────────────────────────────────────────────────────

# Port for Express API server
PORT=3001

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://scopeagent.io

# Node environment
NODE_ENV=development

# ───────────────────────────────────────────────────────────────
# STRIPE (Required for payments)
# Get these from: https://dashboard.stripe.com/apikeys
# ───────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Stripe Price IDs (Individual Plans)
STRIPE_PRICE_PRO_MONTHLY=price_xxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxxxx
STRIPE_PRICE_TEAM_YEARLY=price_xxxxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxx

# Stripe Bundle Price IDs (VaultAgent + ScopeAgent)
STRIPE_BUNDLE_PRO_MONTHLY=price_bundle_pro_monthly
STRIPE_BUNDLE_PRO_YEARLY=price_bundle_pro_yearly
STRIPE_BUNDLE_TEAM_MONTHLY=price_bundle_team_monthly
STRIPE_BUNDLE_TEAM_YEARLY=price_bundle_team_yearly
STRIPE_BUNDLE_ENTERPRISE_MONTHLY=price_bundle_enterprise_monthly
STRIPE_BUNDLE_ENTERPRISE_YEARLY=price_bundle_enterprise_yearly

# ───────────────────────────────────────────────────────────────
# REDIS (Optional - for rate limiting and caching)
# Get from: https://upstash.com or your Redis provider
# ───────────────────────────────────────────────────────────────

REDIS_URL=redis://default:password@your-redis-url:6379

# ───────────────────────────────────────────────────────────────
# WEBSOCKET (API Server)
# ───────────────────────────────────────────────────────────────

# WebSocket port (defaults to same as PORT)
WS_PORT=3001

# WebSocket heartbeat interval (ms)
WS_HEARTBEAT_INTERVAL=30000

# ───────────────────────────────────────────────────────────────
# VAULTAGENT INTEGRATION (Optional)
# For linking with VaultAgent accounts
# ───────────────────────────────────────────────────────────────

VAULTAGENT_API_URL=https://api.vaultagent.io
VAULTAGENT_API_KEY=your-vaultagent-api-key

# ───────────────────────────────────────────────────────────────
# NOTIFICATIONS (Optional)
# ───────────────────────────────────────────────────────────────

# Slack webhook for violation alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Discord webhook for violation alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Email for critical alerts (via Supabase or your provider)
ALERT_EMAIL=alerts@yourcompany.com

# ───────────────────────────────────────────────────────────────
# MONITORING (Optional)
# ───────────────────────────────────────────────────────────────

# Sentry DSN for error tracking
SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog for analytics
POSTHOG_API_KEY=phc_xxxxx
POSTHOG_HOST=https://app.posthog.com

# ───────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY
# ───────────────────────────────────────────────────────────────

# Enable debug logging
DEBUG=scopeagent:*

# Disable rate limiting in development
DISABLE_RATE_LIMIT=false

# Mock external services
MOCK_STRIPE=false
MOCK_VAULTAGENT=false
